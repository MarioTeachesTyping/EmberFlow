# EmberFlow example configuration — SAFE DUMMY VALUES ONLY.
# Copy to `.env` for local development. Never commit `.env`.
# Variable names are proposals; owners may rename them as components are built.

# ---------------------------------------------------------------------------
# Central controller (FastAPI) — owner: R4
# ---------------------------------------------------------------------------
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=8000

# ---------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB) — owner: R5
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://emberflow:change-me@localhost:5432/emberflow

# ---------------------------------------------------------------------------
# Messaging — DECISION OPEN (MQTT vs NATS, see docs/decisions/0004-messaging.md)
# Leave MESSAGING_BACKEND empty until the ADR is accepted.
# ---------------------------------------------------------------------------
MESSAGING_BACKEND=
MQTT_URL=mqtt://localhost:1883
NATS_URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# Edge agent (Raspberry Pi 5 or simulated station) — owner: R2
# ---------------------------------------------------------------------------
STATION_ID=station-sim-01
# A camera device index/URI or a path to a prerecorded video file
VIDEO_SOURCE=./path/to/prerecorded-sample.mp4
# Durable offline buffer location (SQLite recommended, not finalized — ADR 0005)
EDGE_BUFFER_PATH=./var/edge-buffer.sqlite3

# ---------------------------------------------------------------------------
# ML inference — owner: R3 (model choice OPEN — ADR 0006)
# ---------------------------------------------------------------------------
MODEL_PATH=./path/to/model-weights
MODEL_VERSION=unset

# ---------------------------------------------------------------------------
# FPS adaptation policy — owner: R4 with R2/R6
# Intentionally blank: values must be measured on the selected Pi 5
# configuration. Do NOT treat any example value in the docs as a default.
# ---------------------------------------------------------------------------
FPS_POLICY_TEMP_THRESHOLD_C=
FPS_POLICY_LATENCY_THRESHOLD_MS=
FPS_POLICY_OBSERVATION_WINDOW_S=
FPS_POLICY_TARGET_FPS=
FPS_POLICY_COOLDOWN_S=
FPS_COMMAND_TTL_S=
